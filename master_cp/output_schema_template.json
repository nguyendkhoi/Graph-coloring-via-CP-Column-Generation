{
  "description": "Template for main_master run output. Each execution creates master_cp/runs/<instance>/<run_id>/.",
  "run_folder": "master_cp/runs/<instance>/<run_id>/",
  "files": {
    "records_csv": {
      "path": "records.csv",
      "format": "CSV with header",
      "columns": [
        "cg_iteration",
        "rmp_value",
        "number_of_columns",
        "last_reduced_cost",
        "dual_mean",
        "dual_variance",
        "rmp_time",
        "pricing_time"
      ]
    },
    "vertex_features_csv": {
      "path": "vertex_features.csv",
      "format": "CSV with header",
      "columns": [
        "iteration",
        "vertex_id",
        "degree",
        "normalized_degree",
        "dual",
        "weighted_neighbor_dual",
        "complement_degree",
        "stable_set_occurrences",
        "score_contribution"
      ],
      "example_row": "12,17,108,0.870968,0.197100,37.229730,16,12,0.750000"
    },
    "summary_csv": {
      "path": "summary.csv",
      "format": "CSV",
      "columns": [
        "run_id",
        "run_output_dir",
        "run_log_path",
        "instance_path",
        "instance",
        "n",
        "m",
        "num_trials",
        "seed",
        "threads",
        "time_limit_seconds",
        "run_time_seconds",
        "iterations",
        "rmp_status",
        "lp_objective",
        "proven_lb",
        "incumbent_ub",
        "column_count",
        "active_lambdas",
        "total_lambdas",
        "closed_gap",
        "converged_by_pricing",
        "reached_max_iter",
        "reached_time_limit",
        "exit_code"
      ]
    },
    "summary_json": {
      "path": "summary.json",
      "format": "JSON object",
      "record_type": "run_summary"
    }
  },
  "copy_hint": "To create another output format, copy src/master_main/output_writer.cpp and output_writer.h, then change the write/log functions."
}
